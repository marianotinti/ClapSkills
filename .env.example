# ANTHROPIC_API_KEY: Required for Claude (workflow agent at POST /api/mcp/generate, and tools JSON at POST /api/tools/generate when not using mock).
# Optional: ANTRHOPIC_API_KEY (legacy typo) is still read for convenience.
# Optional: ANTHROPIC_MODEL (default: claude-sonnet-4-5-20250929 in code)
ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Optional: model override for POST /api/tools/generate only. Defaults to ANTHROPIC_MODEL (or the same default as above).
# TOOLS_MODEL_NAME=claude-sonnet-4-5-20250929

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_N8N_WEBHOOK_URL: Webhook URL of your n8n workflow that generates the skill JSON.
# Example: https://n8n.yourcompany.com/webhook/create-skill
VITE_N8N_WEBHOOK_URL=""

# VITE_N8N_EXECUTE_WEBHOOK_URL: Global Webhook URL to execute an existing skill.
# The request will contain { skillId, formData }.
VITE_N8N_EXECUTE_WEBHOOK_URL=""
N8N_MCP_SERVER_ACCESS_KEY=""
N8N_MCP_SERVER_URL=""
